{
    "tasks": [
        {
            "type": "shell",
            "label": "CMake: configurar",
            "command": "cmake",
            "args": ["-S", "${workspaceFolder}", "-B", "${workspaceFolder}/build"],
            "problemMatcher": []
        },
        {
            "type": "shell",
            "label": "CMake: build Farming on Brazil",
            "command": "cmake",
            "args": ["--build", "${workspaceFolder}/build", "-j"],
            "dependsOn": "CMake: configurar",
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compila o projeto inteiro pelo CMake (todas as classes + raylib)."
        }
    ],
    "version": "2.0.0"
}
